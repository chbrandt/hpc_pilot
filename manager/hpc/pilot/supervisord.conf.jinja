; supervisord.conf — HPC Pilot managed services

[supervisord]
nodaemon=false
loglevel=info
logfile_backups=3
logfile_maxbytes=10MB
; Can use "%(here)s"
logfile=%(here)s/supervisor.log
pidfile=%(here)s/supervisor.pid

[rpcinterface:supervisor]
supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface

[unix_http_server]
file=%(here)s/supervisor.sock

[supervisorctl]
serverurl=unix://%(here)s/supervisor.sock

[program:wstunnel]
command={{wstunnel_bin}} client
    --http-upgrade-path-prefix '{{wstunnel_secret}}'
    -R tcp://{{wstunnel_local_port}}:localhost:{{wstunnel_local_port}}
    {{wstunnel_protocol}}://{{wstunnel_server_addr}}:{{wstunnel_server_port}}
priority=1
autostart=true
autorestart=true
startretries=5
startsecs=3
stdout_logfile=%(here)s/log/wstunnel.stdout
stderr_logfile=%(here)s/log/wstunnel.stderr

[program:interlink-plugin]
; environment=INTERLINKCONFIGPATH="%(here)s/InterLinkConfig.yaml"
{% if plugin == "slurm" %}
environment=SLURMCONFIGPATH={{plugin_conf}}
{% endif %}
command={{plugin_bin}}
priority=2
autostart=true
autorestart=true
startretries=5
startsecs=3
stdout_logfile=%(here)s/log/interlink_plugin.stdout
stderr_logfile=%(here)s/log/interlink_plugin.stderr
